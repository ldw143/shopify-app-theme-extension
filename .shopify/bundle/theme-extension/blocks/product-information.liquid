<div class="product-information">
  <h2>{{ block.settings.title }}</h2>

  <!-- Render any app blocks -->
  {% for block in section.blocks %}
    {% if block.type == '@app' %}
      {% render block %}
    {% else %}
      <p>Unsupported block type: {{ block.type }}</p>
    {% endif %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "Product Information",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Product Information"
    }
  ]
}
{% endschema %}