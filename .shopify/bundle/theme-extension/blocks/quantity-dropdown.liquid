<div id="inventory-section">
  <h2>Quantity</h2>

  <!-- Render Section Blocks -->
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'dropdown' %}
        <div class="dropdown-block">
          <label for="quantity-dropdown-{{ block.id }}">{{ block.settings.label }}</label>
          <select id="quantity-dropdown-{{ block.id }}" name="quantity">
            {% assign options = block.settings.options | split: ',' %}
            {% for option in options %}
              <option value="{{ option | strip }}">{{ option | strip }}</option>
            {% endfor %}
          </select>
        </div>
      {% else %}
        <p>Unsupported block type: {{ block.type }}</p>
    {% endcase %}
  {% endfor %}

  {% if section.settings.custom_text %}
    <p>{{ section.settings.custom_text }}</p>
  {% endif %}
</div>

<!-- Link CSS and JS -->
<link rel="stylesheet" href="{{ 'section-inventory.css' | asset_url }}" media="print" onload="this.media='all'">
<script src="{{ 'section-inventory.js' | asset_url }}" defer="defer"></script>

<noscript>
  <p>This feature requires JavaScript to function properly. Please enable JavaScript in your browser to use this feature.</p>
</noscript>

{% schema %}
{
  "name": "Quantity Selector Section",
  "settings": [
    {
      "type": "text",
      "id": "custom_text",
      "label": "Custom Text"
    }
  ],
  "blocks": [
    {
      "type": "dropdown",
      "name": "Quantity Dropdown",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Dropdown Label"
        },
        {
          "type": "text",
          "id": "options",
          "label": "Dropdown Options (comma-separated)",
          "default": "1,2,3,4,5"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Quantity Selector",
      "category": "Product",
      "blocks": [
        {
          "type": "dropdown"
        }
      ]
    }
  ]
}
{% endschema %}