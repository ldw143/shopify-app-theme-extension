<div class="empty-box" style="width: 100%; height: 100px; border: 1px dashed #ccc;">
  <!-- Optional text if merchants configure it -->
  {% if block.settings.custom_text %}
    <p>{{ block.settings.custom_text }}</p>
  {% endif %}
</div>

<!-- CSS for styling -->
<style>
  .empty-box {
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #f9f9f9;
  }
</style>

<!-- Optional script if needed -->
<script>
  console.log('Empty box block loaded');
</script>

{% schema %}
{
  "name": "Empty Box",
  "settings": [
    {
      "type": "text",
      "id": "custom_text",
      "label": "Optional Text",
      "default": "This is an empty box."
    }
  ]
}
{% endschema %}