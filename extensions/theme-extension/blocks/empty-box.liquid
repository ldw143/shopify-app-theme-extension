<div class="empty-box" style="width: 100%; height: 100px; border: 1px dashed #ccc;">
  <!-- Display the custom text if provided -->
  {% if block.settings.custom_text %}
    <p>{{ block.settings.custom_text }}</p>
  {% endif %}

  <!-- Quantity Dropdown Logic -->
  <div class="quantity-dropdown">
    <label for="quantity-dropdown-{{ block.id }}">Quantity:</label>
    <select id="quantity-dropdown-{{ block.id }}" name="quantity">
      {% for i in (1..block.settings.quantity_max) %}
        <option value="{{ i }}">{{ i }}</option>
      {% endfor %}
    </select>

    {% if block.settings.allow_fractions %}
      <label for="fraction-dropdown-{{ block.id }}"></label>
      <select id="fraction-dropdown-{{ block.id }}" name="fraction">
        <option value="0">0</option>
        <option value="1/4">1/4</option>
        <option value="1/2">1/2</option>
        <option value="3/4">3/4</option>
      </select>
    {% endif %}
  </div>
</div>

<noscript>
  <p>This feature requires JavaScript to function properly. Please enable JavaScript in your browser to use this feature.</p>
</noscript>

<!-- CSS for styling -->
<style>
  .empty-box {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background-color: #f9f9f9;
  }

  .quantity-dropdown label {
    font-weight: bold;
    margin-bottom: 5px;
  }

  .quantity-dropdown select {
    padding: 5px;
    font-size: 16px;
  }
</style>

<!-- Optional script if needed -->
<script>
  console.log('Empty box block loaded');
</script>

{% schema %}
{
  "name": "Alternate Quantity Selector",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "custom_text",
      "label": "Custom Text",
      "default": "This is an empty box with a dropdown."
    },
    {
      "type": "number",
      "id": "quantity_max",
      "label": "Max Quantity",
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "allow_fractions",
      "label": "Allow Fractional Quantities",
      "default": true
    }
  ]
}
{% endschema %}